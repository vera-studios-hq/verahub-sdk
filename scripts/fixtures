#!/usr/bin/env bash
# Writes the shared fixtures from the examples in spec/publisher.json:
#   fixtures/responses/<operationId>.<status>.json   every response example of a /v1/me route
#   fixtures/requests/<operationId>.json             every request example of a /v1/me route
#   fixtures/problems/<code>.json                    every problem a /v1/me route documents
# and embeds them in the preview module (Sources/VeraHubPreview/Fixtures.swift), so the preview
# needs no resource bundle. With --check, fails if the committed files differ from what it writes.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
spec="$root/spec/publisher.json"
check=false
[[ "${1:-}" == "--check" ]] && check=true

out="$(mktemp -d)"
trap 'rm -rf "$out"' EXIT
mkdir -p "$out/fixtures/responses" "$out/fixtures/requests" "$out/fixtures/problems"

me_operations='.paths | to_entries[] | select(.key | startswith("/v1/me")) | .value | to_entries[] | .value'

# Response examples: "<operationId>.<status>\t<json>"
jq -r "$me_operations"' | .operationId as $op | .responses | to_entries[]
  | select(.value.content["application/json"].example != null)
  | "\($op).\(.key)\t\(.value.content["application/json"].example | tojson)"' "$spec" |
  while IFS=$'\t' read -r name json; do
    jq . <<<"$json" >"$out/fixtures/responses/$name.json"
  done

jq -r "$me_operations"' | select(.requestBody.content["application/json"].example != null)
  | "\(.operationId)\t\(.requestBody.content["application/json"].example | tojson)"' "$spec" |
  while IFS=$'\t' read -r name json; do
    jq . <<<"$json" >"$out/fixtures/requests/$name.json"
  done

jq -r "[$me_operations"' | .responses[] | .content["application/problem+json"].examples // {} | .[] | ."$ref"]
  | unique[] | ltrimstr("#/components/examples/")' "$spec" |
  while read -r name; do
    jq --arg name "$name" '.components.examples[$name].value' "$spec" >"$out/fixtures/problems/$name.json"
  done

swift="$out/Fixtures.swift"
{
  echo "// swift-format-ignore-file"
  echo "// Generated by scripts/fixtures from spec/publisher.json. Do not edit."
  echo ""
  echo "/// The shared fixtures, by their path below \`fixtures/\` without \`.json\`."
  echo "let fixtures: [String: String] = ["
  (cd "$out/fixtures" && find . -name '*.json' | sort) | while read -r file; do
    if grep -q '"#' "$out/fixtures/$file"; then
      echo "fixture $file contains \"#, which ends a raw string literal" >&2
      exit 1
    fi
    key="${file#./}"
    echo "  \"${key%.json}\": #\"\"\""
    cat "$out/fixtures/$file"
    echo "\"\"\"#,"
  done
  echo "]"
} >"$swift"

if $check; then
  if ! diff -r "$out/fixtures" "$root/fixtures" ||
    ! diff "$swift" "$root/Sources/VeraHubPreview/Fixtures.swift"; then
    echo "The fixtures differ from spec/publisher.json's examples: run scripts/fixtures." >&2
    exit 1
  fi
else
  rm -rf "$root/fixtures"
  cp -r "$out/fixtures" "$root/fixtures"
  cp "$swift" "$root/Sources/VeraHubPreview/Fixtures.swift"
fi
